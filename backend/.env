# Backend Environment Variables
# SQLite for local dev (no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./ipcai.db

# For PostgreSQL (uncomment and set when ready):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ipcai

JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Groq API (set when ready)
GROQ_API_KEY=

# Cloudflare R2 (set when ready)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ipcai-pdfs
R2_ENDPOINT_URL=

# App
APP_NAME=IPC.ai
DEBUG=true
